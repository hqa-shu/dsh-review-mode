{
  "name": "@local/dsh-review-mode",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "审核模式：明确选择目标、按新用户消息自动复审，2～4条可展开洞察，独立面板不影响正常问答。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./reviewer": "./reviewer.js",
    "./rubric": "./rubric.js"
  },
  "files": [
    "client.js",
    "evidence-packet.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "reviewer.js",
    "rubric.js",
    "remote.js",
    "README.md",
    "CURRENT-IMPLEMENTATION.md",
    "ITERATIONS.md",
    "README.zh-CN.md",
    "assets/whale-girl/",
    "examples/",
    "scripts/embed-review-art.mjs",
    "scripts/prepare-runtime.mjs",
    "docs/ARCHITECTURE.md",
    "docs/CONFIGURATION.md",
    "docs/EVIDENCE-AND-ADVICE-DESIGN.zh-CN.md",
    "docs/INSTALLATION.md",
    "docs/PRIVACY.md",
    "docs/ROADMAP.md",
    "docs/VALIDATION-2.0-BASELINE.md",
    "docs/VALIDATION.md",
    "docs/source-snapshot-2.1.json",
    "docs/source-snapshot.json",
    "docs/validation-results.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hqa-shu/dsh-review-mode.git"
  },
  "homepage": "https://github.com/hqa-shu/dsh-review-mode#readme",
  "bugs": {
    "url": "https://github.com/hqa-shu/dsh-review-mode/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "ai-agents",
    "conversation-review",
    "agent-evaluation"
  ],
  "author": "Qian'an Huang",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:host": "node test/run.mjs --host",
    "check": "node scripts/check.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs"
  }
}
